#!/usr/bin/env bash
# tools/secret edit|show|keys <file.enc.yaml>
#   edit: mở editor, lưu là tự mã hoá lại · show: in giá trị đã giải mã · keys: chỉ in tên key
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export SOPS_AGE_KEY_FILE="$ROOT/secrets/masterkey/keys.txt"
cmd="${1:-}"; file="${2:-}"
[ -n "$cmd" ] && [ -f "$file" ] || { echo "dùng: tools/secret edit|show|keys <file.enc.yaml>" >&2; exit 1; }
case "$cmd" in
  edit) exec sops "$file" ;;
  show) exec sops -d "$file" ;;
  keys) sops -d "$file" | python3 -c "
import sys, yaml
def walk(x, p=''):
    if isinstance(x, dict):
        for k, v in x.items(): walk(v, f'{p}.{k}' if p else str(k))
    else: print(p)
walk(yaml.safe_load(sys.stdin) or {})" ;;
  *) echo "dùng: tools/secret edit|show|keys <file.enc.yaml>" >&2; exit 1 ;;
esac
